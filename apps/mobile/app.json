{
  "expo": {
    "name": "아이쌤봇",
    "slug": "issam-bot",
    "scheme": "rakazo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0E"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F26A1B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "아이쌤봇에 이미지를 첨부할 때 사진 보관함을 사용합니다.",
          "cameraPermission": "아이쌤봇에 사진을 첨부할 때 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "./plugins/with-worklets-headers"
    ],
    "ios": {
      "bundleIdentifier": "com.issambot.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "아이쌤봇에 사진을 첨부할 때 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "아이쌤봇에 이미지를 첨부할 때 사진 보관함을 사용합니다.",
        "NSLocalNetworkUsageDescription": "같은 네트워크에 직접 띄운 아이쌤봇 서버에 연결할 때 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.issambot.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "projectId": "02c96129-f49c-4074-93af-4ffd9e78868d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "sitpo",
    "updates": {
      "url": "https://u.expo.dev/02c96129-f49c-4074-93af-4ffd9e78868d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
